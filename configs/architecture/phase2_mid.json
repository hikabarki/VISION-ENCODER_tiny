{
  "phase": 2,
  "name": "keural-mid",
  "description": "Mid-level model. Production-grade quality targeting CLIP ViT-L/14 performance class. Trained on large-scale curated data. Suitable for downstream fine-tuning and VLM integration.",

  "parameters": {
    "total": "~230M",
    "breakdown": {
      "stem": "~3M",
      "saliency_head": "~0.6M",
      "atb_tokenizer": "~1M",
      "spatial_transformer": "~225M",
      "level_embeddings": "<0.1M",
      "pool_token": "<0.1M"
    }
  },

  "stem": {
    "channels": [128, 256, 512, 768],
    "kernel_size": 3,
    "activation": "gelu",
    "stride_per_layer": 2,
    "total_stride": 16,
    "note": "stem.channels[-1] must equal spatial.embed_dim"
  },

  "saliency": {
    "hidden_channels": 192,
    "output": "sigmoid map (B, 1, H/16, W/16)"
  },

  "tokenizer": {
    "default_token_budget": 512,
    "max_token_budget": 2048,
    "budget_split": {
      "global": 0.05,
      "region": 0.25,
      "detail": 0.70
    },
    "budget_floors": {
      "global": 8,
      "region": 16,
      "detail": 0
    },
    "saliency_smooth_kernel": { "region": 7, "detail": 3 },
    "nms_radius": { "region": 3, "detail": 1 },
    "gumbel_temperature_start": 1.0,
    "gumbel_temperature_end": 0.05,
    "temperature_anneal_steps": 50000,
    "warmup_steps_fixed_grid": 10000,
    "roi_align_size": 4
  },

  "spatial_transformer": {
    "embed_dim": 768,
    "depth": 24,
    "num_heads": 12,
    "head_dim": 64,
    "mlp_ratio": 4,
    "mlp_type": "SwiGLU",
    "norm_type": "RMSNorm",
    "norm_eps": 1e-6,
    "positional_encoding": "2D RoPE",
    "rope_base": 10000.0,
    "use_pool_token": true
  },

  "loss": {
    "primary": "sigmoid_siglip",
    "lambda_hct": 1.0,
    "lambda_sal": 0.5,
    "lambda_distill": 0.5,
    "hct_alpha": 0.5,
    "saliency_beta": 0.005,
    "learnable_temperature_init": 2.30,
    "learnable_bias_init": -10.0,
    "total_loss_formula": "siglip_loss + 1.0 * hct_loss + 0.5 * sal_loss + 0.5 * distill_loss"
  },

  "knowledge_distillation": {
    "enabled": true,
    "teachers": {
      "natural_images": {
        "model": "google/siglip-so400m-patch14-384",
        "embed_dim": 1152,
        "projection": "nn.Linear(1152, 768)",
        "lambda": 0.5,
        "loss": "1 - cosine_similarity(keural_pooled, siglip_pooled)",
        "batch_type": "natural"
      },
      "documents": {
        "model": "OpenGVLab/InternViT-300M-448px",
        "embed_dim": 768,
        "projection": "none — embed_dim matches keural_mid",
        "lambda": 0.5,
        "loss": "1 - cosine_similarity(keural_pooled, internvit_pooled)",
        "batch_type": "document"
      }
    },
    "teachers_frozen": true,
    "apply_phase": "Phase 1M only — encoder must be trainable for distillation to have effect",
    "note": "Teachers are discarded after training — not part of final model. Full IP ownership retained."
  },

  "training": {
    "precision": "bfloat16",
    "gradient_checkpointing": true,
    "optimizer": "adamw",
    "betas": [0.9, 0.95],
    "weight_decay": 0.05,
    "lr": 5e-4,
    "lr_schedule": "cosine_with_warmup",
    "warmup_steps": 10000,
    "max_steps": 500000,
    "batch_size_per_device": 128,
    "gradient_accumulation": 4,
    "effective_batch_size": 4096,
    "seed": 42
  },

  "data": {
    "datasets": ["CC3M", "CC12M", "COYO-700M: Image-Text Pair Dataset (clip_score > 0.35, top ~30%)"],
    "total_samples": "~230M",
    "dataset_note": "COYO-700M filtered to ~215M high-quality pairs + 15M CC3M/CC12M. Simple single-source pipeline.",
    "image_buckets": [
      [224, 224], [256, 256], [320, 320],
      [384, 384], [448, 448], [512, 512]
    ],
    "text_encoder": "openai/clip-vit-large-patch14 text tower (frozen, 768-dim — matches embed_dim)",
    "text_encoder_note": "Upgrade from MiniLM-L6 (384-dim used in POC). CLIP text tower outputs 768-dim matching encoder embed_dim — no projection needed.",
    "num_workers": 16,
    "deduplication": true,
    "nsfw_filtering": true,
    "quality_scoring": true
  },

  "hardware": {
    "target_gpu": "8× H100 80GB or 8× A100 80GB",
    "vram_required": "~60 GB per GPU",
    "estimated_training_time": "7-14 days",
    "gpus": 8,
    "multi_node": false
  },

  "output": {
    "token_sequence": "(B, N, 768)",
    "pooled_vector": "(B, 768)",
    "level_ids": "(B, N) — 0=global, 1=region, 2=detail",
    "spatial_metadata": "(B, N, 4) — cx, cy, w, h normalized"
  },

  "improvements_over_phase1": [
    "2× embed_dim (384→768) — richer token representations",
    "2× depth (12→24) — deeper reasoning over token hierarchy",
    "2× default token budget (256→512) — finer spatial detail",
    "Larger roi_align_size (2→4) — better region feature extraction",
    "Trained on 230M vs 6.9M samples — much stronger generalization (COYO-700M clip_score > 0.35 + CC3M + CC12M)",
    "Data cleaning pipeline — dedup + NSFW + quality scoring",
    "Larger image buckets (up to 512×512) — high-res understanding"
  ]
}
